FROM mcr.microsoft.com/playwright/python:v1.60.0-jammy

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PYTHONPATH=/app

WORKDIR /app

COPY backend/requirements.txt /tmp/requirements.txt
COPY backend/Aptfile /tmp/Aptfile

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive xargs -a /tmp/Aptfile apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --upgrade pip \
    && pip install -r /tmp/requirements.txt \
    && python -m playwright install chromium \
    && chrome_binary="$(find /ms-playwright/chromium-* -type f -path '*/chrome-linux64/chrome' | sort -V | tail -n 1)" \
    && test -n "$chrome_binary" \
    && printf '#!/bin/sh\nexec "%s" --no-sandbox --disable-dev-shm-usage --disable-gpu --headless=new "$@"\n' "$chrome_binary" > /usr/local/bin/google-chrome \
    && chmod +x /usr/local/bin/google-chrome \
    && ln -sf /usr/local/bin/google-chrome /usr/bin/google-chrome-stable \
    && ln -sf /usr/local/bin/google-chrome /usr/bin/google-chrome

COPY backend /app/backend

# Exercise the exact Robot Framework execution strategy used by the API while
# building the image. This fails the deploy early if Chrome cannot be started.
RUN python - <<'PY'
from backend.infrastructure.TestExecutor import TestExecutor

smoke_script = """*** Settings ***
Library    SeleniumLibrary

*** Test Cases ***
Chrome launches in the backend runtime
    Open Browser    data:text/html,<title>GenIA Railway smoke</title>    chrome
    Title Should Be    GenIA Railway smoke
    Close Browser
"""

result = TestExecutor().execute("robotframework", smoke_script, language="python")
if result.status != "passed":
    print("Robot Framework Chrome smoke test failed:")
    print(result.stdout)
    print(result.stderr)
    raise SystemExit(1)
print("Robot Framework Chrome smoke test passed")
PY

EXPOSE 8080

# One process keeps the in-memory queue/semaphore coordinated; enough request
# threads remain available for 10 concurrent SSE log streams plus API polling.
CMD ["sh", "-c", "exec gunicorn backend.api:app --bind 0.0.0.0:${PORT:-8080} --workers 1 --threads 24 --worker-class gthread --timeout 600 --keep-alive 120"]
